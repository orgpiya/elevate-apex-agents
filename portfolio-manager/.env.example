# Portfolio Manager Environment Variables

# GCP Project ID (required)
GOOGLE_CLOUD_PROJECT=your-project-id

# Gemini Model Location (defaults to global for gemini-3.5-flash)
GEMINI_LOCATION=global

# Agent URLs for delegation
# Financial Auditor Resource Name (e.g. projects/1234/locations/us-central1/reasoningEngines/5678)
FINANCIAL_AUDITOR_URL=projects/your-project-id/locations/us-central1/reasoningEngines/your-engine-id
TRANSACTION_EXECUTOR_URL=https://transaction-executor-xyz.a.run.app
